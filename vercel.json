{
  "version": 2,
  "builds": [
    {
      "src": "run.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/app/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/run.py"
    }
  ],
  "env": {
    "FLASK_DEBUG": "false",
    "DEMO_MODE": "true",
    "CONFIDENCE_THRESHOLD": "0.85"
  }
}
